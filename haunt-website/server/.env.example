NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Hmk1752003!@
DB_NAME=haunt_store
DB_CONNECTION_LIMIT=10

# Authentication (Step 11). Use a long random secret — at least 32 characters.
# Auth is unavailable until JWT_SECRET is set to a real secret; the value
# below is only a placeholder and is rejected as if it were missing.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h

# Optional public origin for absolute image URLs. Leave empty locally so
# /uploads paths work through the Vite proxy on the frontend origin.
PUBLIC_BASE_URL=

# Optional local write token for admin routes. Admin JWT login works without
# it; set this only if scripts or tools need token-based admin access.
# Leave empty to keep token-based admin access denied.
ADMIN_API_TOKEN=
